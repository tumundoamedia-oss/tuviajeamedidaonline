---
import BaseLayout from '../layouts/BaseLayout.astro';

const whatsappNumber = "34603268490";

const ofertas = [
  {
    title: "París Romántico",
    description: "Disfruta 5 días en París con vuelo y hotel incluidos. Experiencia ideal para parejas.",
    image: "/images/uploads/headerphotoparis.avif"
  },
  {
    title: "Roma Histórica",
    description: "4 días explorando los monumentos, la gastronomía y la cultura de Roma.",
    image: "/images/uploads/roma.jpg"
  },
  {
    title: "Londres imperial",
    description: "3 dias recorriendo la capital britanica.",
    image: "/images/uploads/londres.jpg"
  }
];
---

<BaseLayout title="Ofertas Especiales | Tu Mundo a Medida">

  <main style="max-width: 1280px; margin: 0 auto; padding: 80px 20px;">
    <h1 style="text-align:center; font-size:3rem; margin-bottom:3.5rem; color: var(--primary);">
      Ofertas Especiales
    </h1>

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.8rem;
    ">
      {ofertas.map(oferta => (
        <div class="card">
          <img 
            src={oferta.image} 
            alt={oferta.title} 
            style="width:100%; height:280px; object-fit:cover;"
            loading="lazy"
          />
          <div style="padding: 2rem;">
            <h2 style="font-size:1.85rem; margin-bottom:1rem; color: var(--primary);">
              {oferta.title}
            </h2>
            <p style="color: var(--text-light); line-height:1.7; margin-bottom:1.8rem;">
              {oferta.description}
            </p>
            <a
              href={`https://wa.me/${whatsappNumber}?text=Hola!%20Me%20interesa%20${encodeURIComponent(oferta.title)}`}
              target="_blank"
              class="btn-whatsapp"
              style="width: 100%; text-align: center; font-size: 1.1rem;"
            >
              Consultar esta oferta
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>

</BaseLayout>
